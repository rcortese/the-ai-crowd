## Runtime (required for all users)

TZ=America/Sao_Paulo

WORKBENCH_USER=operator
# These must match the owner of the bind-mounted host directories under ./data.
WORKBENCH_UID=1000
WORKBENCH_GID=1000

# Only used with compose.docker.yaml to access the host Docker socket.
# Set this to `stat -c %g /var/run/docker.sock` on the host before starting Docker-aware mode.
# `998` is only an example placeholder, not a portable default.
DOCKER_GID=998

# Codex MCP model name passed to `codex mcp-server`. Default matches the bundled CLI version.
# Override only if OpenAI changes the model name independently of the CLI binary.
# CODEX_MCP_MODEL=gpt-5.3-codex

ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

## Build overrides (only used with compose.build.yaml)
# These values are ignored in pull-first mode. The Dockerfile ARG defaults are
# the canonical source of truth for the published image.

# NODE_MAJOR=22
# NODE_VERSION=22.22.2
# CLAUDE_CODE_VERSION=2.1.146
# GEMINI_CLI_VERSION=0.42.0
# CODEX_CLI_VERSION=0.132.0
# Pinned upstream snapshot used to fetch claude-delegator during image build.
# CLAUDE_DELEGATOR_COMMIT=6c3535b642ce8ea352f7fac85d063f6b6d62253f
# CLAUDE_DELEGATOR_SHA256=087d8f4254fadb607360df8f04a21ffb2cee042d2b6a355a7f99d44c53aef27f
# Pin docker-ce-cli to a specific version (e.g. 5:27.5.1-1~ubuntu.24.04~noble).
# Leave empty to install the latest stable release from the Docker apt repo.
# DOCKER_CE_CLI_VERSION=
